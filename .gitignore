# R session artefacts
.Rproj.user
.Rhistory
.RData
.Ruserdata
Rplots.pdf
*.log

# Stray PDFs at top level (CBS docs belong in docs/cbs-catalogs/)
/*.pdf

# Claude Code settings (local only)
.claude/

# Generated plots (reproducible from scripts)
plots/

# CBS documentation PDFs (download with: Rscript docs/download_pdfs.R)
docs/cbs-catalogs/**/*.pdf

# Extracted text and metadata from PDFs (regenerate with: Rscript docs/extract_pdfs.R)
docs/extracted/

# Built package tarballs
*.tar.gz

# Vignette build artefacts
/doc/
/Meta/
vignettes/*.html

# Test projects (user experience sandboxes)
evrb/
test_ux_ebrb/
