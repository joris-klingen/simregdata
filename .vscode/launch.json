{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "R-Debugger",
      "request": "launch",
      "name": "Debug current R file",
      "debugMode": "file",
      "workingDirectory": "${workspaceFolder}",
      "file": "${file}"
    },
    {
      "type": "R-Debugger",
      "request": "launch",
      "name": "Debug package (load_all + breakpoints in R/)",
      "debugMode": "workspace",
      "workingDirectory": "${workspaceFolder}",
      "loadPackages": ["."],
      "setBreakpointsInPackages": true
    },
    {
      "type": "R-Debugger",
      "request": "launch",
      "name": "Launch R workspace",
      "debugMode": "workspace",
      "workingDirectory": "${workspaceFolder}"
    },
    {
      "type": "R-Debugger",
      "request": "attach",
      "name": "Attach to running R"
    }
  ]
}
