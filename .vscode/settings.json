{
  // --- R language server & terminal ---
  "r.rpath.windows": "C:\\Program Files\\R\\R-4.5.1\\bin\\R.exe",
  "r.rterm.windows": "C:\\Users\\admin\\AppData\\Local\\Packages\\PythonSoftwareFoundation.Python.3.13_qbz5n2kfra8p0\\LocalCache\\local-packages\\Python313\\Scripts\\radian.exe",
  "r.rterm.option": [],
  "r.bracketedPaste": true,
  "r.alwaysUseActiveTerminal": false,
  "r.sessionWatcher": true,

  // --- Plots: interactive httpgd viewer instead of static png ---
  "r.plot.useHttpgd": true,

  // --- Diagnostics / linting via lintr ---
  "r.lsp.diagnostics": true,

  // --- Editor behaviour for R files ---
  "[r]": {
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.rulers": [80],
    "editor.wordWrap": "off",
    "editor.formatOnSave": false
  },
  "[rmd]": {
    "editor.tabSize": 2,
    "editor.wordWrap": "on"
  },

  // --- Treat package files sensibly ---
  "files.associations": {
    "DESCRIPTION": "debian-control",
    "NAMESPACE": "r",
    ".Rprofile": "r",
    "*.Rproj": "ini"
  },
  "files.exclude": {
    "**/.Rproj.user": true,
    "**/*.Rcheck": true
  }
}
